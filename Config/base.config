# ============================================================
# 纯净基底：LuCI（默认 bootstrap）+ 简体中文 + 选中的自定义包
# 目标/分区/驱动/autocore 变体等设备项在 Config/<设备>.config
# 依赖：buildroot 按 Makefile 的 DEPENDS 自动拉取，本文件只列"想要的功能包"
# ============================================================

### LuCI 与语言（官方 feeds）###
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y

# ⚠ 刻意不设 CONFIG_ALL_KMODS。
# 它的语义是 "Select all kernel module packages by default"，会把官方树里每一个 kmod
# 都默认选中并编译，是 H68K 冷构建逼近 6h 上限、X86 要 2.5h 的主因。
# 设备真正需要的 kmod 在 Config/<设备>.config 里显式列出即可（defconfig 会保留显式选择），
# 被其他包依赖的 kmod 由 Makefile 的 DEPENDS 自动带入，不需要这个开关。

### 自定义包在官方 feeds 中的依赖（显式选中）###
# 核心包（docker/kixdns/easytier/openlist2/oaf 等）由各自 luci-app 的 DEPENDS 自动带入，不在此列
CONFIG_PACKAGE_node=y              # 网易云解锁依赖 +node（换 sbwml 预编译版）
CONFIG_PACKAGE_zerotier=y          # rabbitrogi LuCI 依赖官方 zerotier 核心
CONFIG_PACKAGE_dnsmasq-full=y      # 网易云解锁依赖（自动顶替 dnsmasq）
CONFIG_PACKAGE_xz-utils=y          # adguardhome 依赖 +tar，而 tar 需先选中 xz-utils 才可见

### 上游自定义包（由 Scripts/Packages.sh 克隆进 package/custom）###
# --- NAT 维护 / P2P / 端口转发 ---
CONFIG_PACKAGE_luci-app-natmapt=y
CONFIG_PACKAGE_stuntman-client=y
CONFIG_PACKAGE_luci-app-socat-reforged=y
# --- DNS ---
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-app-oxidns=y
CONFIG_PACKAGE_luci-app-kixdns=y
# 包名带 -tk（PROVIDES/CONFLICTS luci-app-adguardhome）。两个前提缺一不可：
#   1) 克隆目录名必须等于 PKG_NAME（package/custom/luci-app-adguardhome-tk），
#      与上游 build-apk.sh 的 PKG_DIR_NAME 做法一致；若用 adguardhome 作目录名，
#      会与官方核心包同名导致元数据采集异常。
#   2) 必须删掉官方 feeds 的 luci-app-adguardhome（Packages.sh 已处理），
#      否则 CONFLICTS 会让本包被 defconfig 静默取消。
CONFIG_PACKAGE_luci-app-adguardhome-tk=y
# --- 穿透 / 带宽 / 组网 ---
CONFIG_PACKAGE_luci-app-bandix=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_luci-app-honk=y
CONFIG_PACKAGE_luci-app-zerotier=y
# --- 媒体 / 推送 ---
CONFIG_PACKAGE_luci-app-unblockneteasemusic=y
CONFIG_PACKAGE_luci-app-wechatpush=y
# --- 任务 / 定时 / 看门狗 / 分区 ---
CONFIG_PACKAGE_luci-app-taskplan=y
CONFIG_PACKAGE_luci-app-tasks=y
CONFIG_PACKAGE_luci-app-timecontrol=y
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-app-watchdog=y
# --- 容器 / 磁盘 / 文件 / 网盘 ---
CONFIG_PACKAGE_luci-app-dockox=y
CONFIG_PACKAGE_luci-app-diskbox=y
CONFIG_PACKAGE_luci-app-harbor-file-pro=y
CONFIG_PACKAGE_luci-app-openlist2=y
CONFIG_PACKAGE_luci-app-wolmon=y
# --- 运维 / 订阅 ---
CONFIG_PACKAGE_luci-app-netspeedtest=y
CONFIG_PACKAGE_luci-app-online-upgrade=y
CONFIG_PACKAGE_luci-app-substore=y
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-app-airconnect=y
# --- 主题 ---
CONFIG_PACKAGE_luci-theme-lumen=y
CONFIG_PACKAGE_luci-theme-footstrap=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
