# ============================================================
# 公共配置：所有设备共用
#   - 设备差异（target / profile / 专属驱动 / 分区）在 Config/<设备>.config
#   - buildroot 会按 Makefile 的 DEPENDS 自动拉依赖，这里只列"想要的功能"
#   - defconfig 会丢弃对当前 target 不适用的符号，不会因此报错
# ============================================================

# ============================================================
# 一、LuCI 与语言
# ============================================================
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-mod-dashboard=y   # 新版仪表盘模块（LuCI 首页概览页）
CONFIG_PACKAGE_luci-proto-wireguard=y

# 关闭 LuCI 静态资源压缩：便于直接改前端调试，代价是镜像略大
# CONFIG_LUCI_CSSTIDY is not set
# CONFIG_LUCI_JSMIN is not set

# ============================================================
# 二、自定义包在官方 feeds 中的依赖（显式选中）
# ============================================================
# 核心包（docker / kixdns / easytier / openlist2 / oaf 等）由各自 luci-app 的
# DEPENDS 自动带入，不在此列
CONFIG_PACKAGE_node=y              # 网易云解锁依赖 +node（已换 sbwml 预编译版）
CONFIG_PACKAGE_zerotier=y          # rabbitrogi LuCI 依赖官方 zerotier 核心
CONFIG_PACKAGE_dnsmasq-full=y      # 网易云解锁依赖（自动顶替 dnsmasq）
# xz-utils 见「六、系统工具」：adguardhome 依赖 +tar，而 tar 需先选中 xz-utils 才可见

# ============================================================
# 三、上游自定义包（由 Scripts/Packages.sh 克隆进 package/custom）
# ============================================================
# --- NAT 维护 / P2P / 端口转发 ---
CONFIG_PACKAGE_luci-app-natmapt=y
CONFIG_PACKAGE_stuntman-client=y
CONFIG_PACKAGE_luci-app-socat-reforged=y

# --- DNS ---
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-app-oxidns=y
CONFIG_PACKAGE_luci-app-kixdns=y
# 包名带 -tk（PROVIDES/CONFLICTS luci-app-adguardhome）。两个前提缺一不可：
#   1) 克隆目录名必须等于 PKG_NAME（package/custom/luci-app-adguardhome-tk），
#      与上游 build-apk.sh 的 PKG_DIR_NAME 做法一致；若用 adguardhome 作目录名，
#      会与官方核心包同名导致元数据采集异常。
#   2) 必须删掉官方 feeds 的 luci-app-adguardhome（Packages.sh 已处理），
#      否则 CONFLICTS 会让本包被 defconfig 静默取消。
CONFIG_PACKAGE_luci-app-adguardhome-tk=y
# smartdns 使用 pymumu 上游原版（Packages.sh 已替换 feeds 自带版本）。
# 注意：它默认会接管 53 端口，与 mosdns / kixdns / oxidns / adguardhome 同开时需手动规划
# 谁做前置、谁做上游，否则只有最后启动的那个能监听成功。
CONFIG_PACKAGE_luci-app-smartdns=y
# smartdns 的 Web 仪表盘（Rust 实现）。代价很大，务必知悉：
#   1) 触发 PKG_BUILD_DEPENDS 的 rust/host，需要额外编译 Rust 工具链（+20~40 分钟）
#   2) Build/Compile/smartdns-ui 还会 cargo install bindgen-cli 并编译 Rust 插件
#   3) Build/Compile/smartdns-webui 需要 npm install + npm run build（联网拉依赖）
# 综合下来单这一项约 +40~70 分钟构建时间。ARM 设备已在各自的 config 里关掉。
CONFIG_PACKAGE_smartdns-ui=y

# --- 穿透 / 带宽 / 组网 ---
CONFIG_PACKAGE_luci-app-bandix=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_luci-app-honk=y
CONFIG_PACKAGE_luci-app-zerotier=y

# --- 媒体 / 推送 ---
CONFIG_PACKAGE_luci-app-unblockneteasemusic=y
CONFIG_PACKAGE_luci-app-wechatpush=y

# --- 任务 / 定时 / 看门狗 / 分区 ---
CONFIG_PACKAGE_luci-app-taskplan=y
CONFIG_PACKAGE_luci-app-tasks=y
CONFIG_PACKAGE_luci-app-timecontrol=y
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-app-watchdog=y

# --- 容器 / 磁盘 / 文件 / 网盘 ---
CONFIG_PACKAGE_luci-app-dockox=y
CONFIG_PACKAGE_luci-app-diskbox=y
CONFIG_PACKAGE_luci-app-harbor-file-pro=y
CONFIG_PACKAGE_luci-app-openlist2=y
CONFIG_PACKAGE_luci-app-wolmon=y

# --- 运维 / 订阅 ---
CONFIG_PACKAGE_luci-app-netspeedtest=y
CONFIG_PACKAGE_luci-app-online-upgrade=y
CONFIG_PACKAGE_luci-app-substore=y
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-app-airconnect=y

# --- 主题 ---
CONFIG_PACKAGE_luci-theme-lumen=y
CONFIG_PACKAGE_luci-theme-footstrap=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y

# ============================================================
# 四、网络应用与服务（官方 feeds）
# ============================================================
# --- 常用网络应用 ---
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-watchcat=y

# --- 代理套件（均来自 helloworld 整仓）---
# ⚠ 这些套件功能高度重叠：都要接管 DNS、防火墙重定向（TProxy/TPROXY+nft）与路由策略。
#   同时启用会大幅增加镜像体积与编译时间（各自带 xray / sing-box / clash / dae 等 Go 二进制），
#   开机后也可能互相争抢 53 端口和 nft 规则。构建通过 ≠ 建议同时开启。
#   dae 与 daed 是同一项目的两代实现，daed 带常驻守护进程，一般二选一即可。
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_mihomo-meta=y
CONFIG_PACKAGE_luci-app-momo=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-dae=y
CONFIG_PACKAGE_luci-app-daed=y

# --- DDNS 脚本与服务商驱动 ---
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_ddns-scripts-freedns=y
CONFIG_PACKAGE_ddns-scripts-godaddy=y

# --- L2TP 服务端 / 客户端 ---
CONFIG_PACKAGE_kmod-l2tp=y
CONFIG_PACKAGE_kmod-pppol2tp=y
CONFIG_PACKAGE_ppp-mod-pppol2tp=y
CONFIG_PACKAGE_xl2tpd=y

# --- iOS 共享网络（USB tethering）---
CONFIG_PACKAGE_usbmuxd=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y

# ============================================================
# 五、内核模块
# ============================================================
# ⚠ 刻意不设 CONFIG_ALL_KMODS。
# 它的语义是 "Select all kernel module packages by default"，会把官方树里每一个
# kmod 都默认选中并编译，是 H68K 冷构建逼近 6h 上限、X86 要 2.5h 的主因。
# 这里按需显式列出即可，被包依赖的 kmod 由 DEPENDS 自动带入。

# --- 网络 / 转发 / 调度 ---
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nf-socket=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-sched=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-tls=y

# --- 加密 ---
CONFIG_PACKAGE_kmod-crypto-chacha20poly1305=y
CONFIG_PACKAGE_kmod-crypto-sha256=y

# --- 文件系统 ---
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-xfs=y

# --- 中文编码（挂载 FAT/NTFS 中文文件名）---
CONFIG_PACKAGE_kmod-nls-cp936=y
CONFIG_PACKAGE_kmod-nls-cp950=y

# --- USB ---
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb2-pci=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-audio=y
CONFIG_PACKAGE_kmod-usb-hid=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-mt7921u=y          # MT7921 USB Wi-Fi 网卡

# --- 其他 ---
CONFIG_PACKAGE_kmod-ikconfig=y

# 注：kmod-hwmon-pwmfan 只存在于 ARM 目标（x86 的 kmods 索引里没有），
# 已放在 Config/h68k.config，不要加到本文件，否则 x86 构建的包校验会报缺失。

# ============================================================
# 六、系统工具
# ============================================================
# --- Shell / 编辑 / 会话 ---
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_vim=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_tree=y

# --- 磁盘 / 文件系统工具 ---
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_xfs-admin=y
CONFIG_PACKAGE_xfs-fsck=y
CONFIG_PACKAGE_xfs-growfs=y
CONFIG_PACKAGE_xfs-mkfs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_gdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fstrim=y
CONFIG_PACKAGE_resize2fs=y

# --- 压缩 / 归档 ---
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_xz=y
CONFIG_PACKAGE_xz-utils=y

# --- 网络 / 传输 ---
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_sshpass=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_lrzsz=y
CONFIG_PACKAGE_telnet-bsd=y

# --- 诊断 / 信息 ---
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_lscpu=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_dmesg=y
CONFIG_PACKAGE_taskset=y
CONFIG_PACKAGE_file=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_sed=y
CONFIG_PACKAGE_rename=y
CONFIG_PACKAGE_qrencode=y

# --- 无线 ---
# 默认 wpad-basic-mbedtls 换成 openssl 完整版（需要 802.11s / WPA3 / 多 SSID）
CONFIG_PACKAGE_wpad-openssl=y

# --- 时区 ---
CONFIG_PACKAGE_zoneinfo-asia=y

# --- GNU coreutils（逐个选，避免整包体积）---
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-cat=y
CONFIG_PACKAGE_coreutils-chmod=y
CONFIG_PACKAGE_coreutils-chown=y
CONFIG_PACKAGE_coreutils-chroot=y
CONFIG_PACKAGE_coreutils-cp=y
CONFIG_PACKAGE_coreutils-date=y
CONFIG_PACKAGE_coreutils-dd=y
CONFIG_PACKAGE_coreutils-dircolors=y
CONFIG_PACKAGE_coreutils-ls=y
CONFIG_PACKAGE_coreutils-mkdir=y
CONFIG_PACKAGE_coreutils-mv=y
CONFIG_PACKAGE_coreutils-nproc=y
CONFIG_PACKAGE_coreutils-rm=y
CONFIG_PACKAGE_coreutils-sleep=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_coreutils-truncate=y

# --- procps-ng ---
CONFIG_PACKAGE_procps-ng=y
CONFIG_PACKAGE_procps-ng-free=y
CONFIG_PACKAGE_procps-ng-ps=y
CONFIG_PACKAGE_procps-ng-top=y

# ============================================================
# 七、库与编译选项
# ============================================================
# --- Curl ---
CONFIG_LIBCURL_NGHTTP3=y
CONFIG_LIBCURL_NGTCP2=y
CONFIG_LIBCURL_OPENSSL=y
# CONFIG_LIBCURL_GNUTLS is not set
# CONFIG_LIBCURL_MBEDTLS is not set
# CONFIG_LIBCURL_NOSSL is not set
# CONFIG_LIBCURL_WOLFSSL is not set

# --- OpenSSL ---
CONFIG_OPENSSL_ENGINE=y
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
CONFIG_OPENSSL_WITH_ASM=y
CONFIG_PACKAGE_libopenssl-afalg=y
CONFIG_PACKAGE_libopenssl-conf=y
CONFIG_PACKAGE_libopenssl-devcrypto=y
CONFIG_PACKAGE_libopenssl-legacy=y
CONFIG_PACKAGE_openssl-util=y
# CONFIG_PACKAGE_libopenssl-padlock is not set
# CONFIG_OPENSSL_WITH_ERROR_MESSAGES is not set

# --- BusyBox（自定义裁剪）---
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_ASH_HELP=y
CONFIG_BUSYBOX_CONFIG_FEATURE_EDITING_HISTORY=1024
CONFIG_BUSYBOX_CONFIG_FEATURE_EDITING_SAVEHISTORY=y
CONFIG_BUSYBOX_CONFIG_FEATURE_PREFER_IPV4_ADDRESS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_SH_HISTFILESIZE=y
CONFIG_BUSYBOX_CONFIG_FEATURE_SYSLOG_INFO=y

# --- Docker（由 luci-app-dockox 带入核心）---
CONFIG_DOCKER_CGROUP_OPTIONS=y
CONFIG_DOCKER_NET_ENCRYPT=y
CONFIG_DOCKER_NET_MACVLAN=y
CONFIG_DOCKER_NET_OVERLAY=y
CONFIG_DOCKER_NET_TFTP=y
CONFIG_DOCKER_OPTIONAL_FEATURES=y
CONFIG_DOCKER_STO_BTRFS=y
CONFIG_DOCKER_STO_EXT4=y

# --- Zram ---
CONFIG_PACKAGE_zram-swap=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# --- zlib ---
CONFIG_ZLIB_OPTIMIZE_SPEED=y

# --- 固件版本信息 ---
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_FILENAMES=y

# ============================================================
# 八、已停用项（官方 25.12 中不存在，加进来会被 defconfig 静默丢弃）
# ============================================================
# 官方树没有这些包，本仓库也不打相应内核补丁，故不启用：
#   CONFIG_PACKAGE_kmod-tcp-bbr3      —— 需 BBRv3 内核补丁；官方只有 kmod-tcp-bbr（BBR v1）
#   CONFIG_PACKAGE_kmod-tcp-brutal    —— 非官方树内包，需 tcp-brutal 内核模块补丁
#   CONFIG_PACKAGE_kmod-nft-fullcone  —— 25.12 已移除 Fullcone-NAT，上游改用 FlowCone 方案
#   CONFIG_PACKAGE_kmod-usb-net-rtl8152-vendor —— 官方 x86 kmods 索引中未见（target 相关）
# 索引中未见、无法确认包名的（如确需请先查 feeds 源）：
#   CONFIG_PACKAGE_bash-completion
#   CONFIG_PACKAGE_ftp
#   CONFIG_PACKAGE_zip
