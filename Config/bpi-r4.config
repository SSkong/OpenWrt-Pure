# Banana Pi BPI-R4 (MT7988A) —— 官方原生支持，不动内核
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_bananapi_bpi-r4=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
# sdcard 镜像对 recovery 分区有 44m 硬校验，全量固件必超 → 关闭 recovery initramfs
# （sysupgrade.itb / eMMC / SPI-NAND 刷机文件不受影响）
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
# 说明：YAOF 的三专属应用（fan-bpir4/sfpmon/mtk-wed）属于自维护 fork 包，
# 不在纯净基底范围内，未引入；后续需要时单独加仓库即可。
