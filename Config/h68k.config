# Hinlink H68K (RK3568) —— 官方 25.12 无此设备，需 backport PR#21270（唯一的内核/设备改动）
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_hinlink_h68k=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-fs-ext4=y
# 硬件信息包（MinimaxFlora/autocore 的 arm 变体）
CONFIG_PACKAGE_autocore-arm=y

# ---- 构建时间控制 ----
# base.config 里开启了 smartdns-ui，它需要 rust/host 工具链 + cargo + npm 构建，
# 单项约 +40~70 分钟。H68K 本来就是最慢的目标，叠上去必然超时，
# 故在设备层覆盖关闭（config 拼接时后者生效）。需要时删掉这行即可。
# CONFIG_PACKAGE_smartdns-ui is not set
