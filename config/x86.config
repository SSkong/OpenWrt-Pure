# X86 (x86/64 generic) —— 官方原生支持，不动内核
#
# 定位：这台 x86 是跑在 PVE 里的路由虚拟机（q35 + OVMF + virtio-scsi-single），
# 不是拿来刷物理机 U 盘的，所以下面三处都按「VM 优先」取舍。
# 顺带记一条已验证的事实：x86/64 子目标的内核配置（target/linux/x86/64/config-6.12）
# 里 VIRTIO_PCI / VIRTIO_BLK / VIRTIO_NET / VIRTIO_SCSI / VIRTIO_BALLOON /
# HW_RANDOM_VIRTIO 全是 =y，virtio 相关驱动内建，不需要额外装任何 kmod。
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_GRUB_TIMEOUT="0"

# PVE 用 ext4 根分区，不用 squashfs：
#   1) 导入 8G 磁盘后可以 fdisk 删掉重建分区 2 + resize2fs 直接扩到整盘；
#      squashfs 的只读根没法这么干（overlay 只能靠 partition 剩余空间）
#   2) 没有 overlay 层，/etc/config 之外的写入行为更接近普通 Linux，排障直观
#   3) 代价是没有「一键恢复出厂」的只读基底，回滚靠快照/备份
CONFIG_TARGET_ROOTFS_EXT4FS=y
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set

# 只出 UEFI（OVMF）变体：PVE 里 q35 + OVMF 用的是 *-ext4-combined-efi.img.gz。
# legacy BIOS 的 combined.img.gz 在 VM 场景用不上，关掉能少做一份 1G 镜像、
# 少写一份临时文件（x86 镜像阶段是整轮构建的磁盘峰值）。
CONFIG_GRUB_EFI_IMAGES=y
# CONFIG_GRUB_IMAGES is not set
# 产物保持 .gz（qm importdisk 前 gunzip 一次即可，发布体积小一半）
CONFIG_TARGET_IMAGES_GZIP=y

# docker 不编：容器跑在 PVE 的 LXC / 独立 VM 里，路由镜像里再带一套 dockerd
# 只是白占 200MB+ 和一堆 kmod。base.config 里那组 CONFIG_DOCKER_* 会随之失效
# （没有 docker 包时它们只是空转，不会报错）。
# CONFIG_PACKAGE_luci-app-dockox is not set
# 常见有线/万兆网卡 + Intel 核显
# 注意：官方树没有 kmod-igb-intel（Intel igb 就是 kmod-igb，且已在 x86/64 的
# Device/generic 默认包里，无需也不能重复指定）。原先这一行是无效符号，defconfig 会丢弃。
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-i40e=y
CONFIG_PACKAGE_kmod-mlx4-core=y
CONFIG_PACKAGE_kmod-mlx5-core=y
CONFIG_PACKAGE_kmod-ixgbevf=y
CONFIG_PACKAGE_kmod-iavf=y
CONFIG_PACKAGE_kmod-drm-i915=y
CONFIG_PACKAGE_i915-firmware-dmc=y
# 硬件信息包（MinimaxFlora/autocore 的 x86 变体）
CONFIG_PACKAGE_autocore-x86=y
